rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{videoName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (
          request.auth.token.moderator == true
          || request.auth.token.email == 'Dalachartsuniversity@gmail.com'
        );
    }
  }
}
